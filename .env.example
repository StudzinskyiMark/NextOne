# NextOne environment variables
# Copy this file to .env.local and fill in the values:  cp .env.example .env.local
# Never commit .env.local or any file with real keys.

# =============================================================================
# Next.js app (.env.local)
# =============================================================================

# --- Convex ---
# Written automatically by `npx convex dev` (e.g. dev:your-deployment-name).
CONVEX_DEPLOYMENT=
# Convex dashboard -> your deployment -> Settings -> URL (ends in .convex.cloud).
# Also written automatically by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
# Same deployment's HTTP Actions URL (ends in .convex.site). Used by the Better Auth proxy in lib/auth-server.ts.
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- App URLs ---
# Public URL of this app, used by app/sitemap.ts and app/robots.ts (http://localhost:3000 locally).
NEXT_PUBLIC_APP_URL=
# Not read by app code; Better Auth reads it as a fallback base URL. Passed in CI. Same value as SITE_URL.
BETTER_AUTH_URL=

# --- Vercel Edge Config (optional) ---
# Connection string for maintenance mode in proxy.ts. Vercel -> Storage -> Edge Config -> Connect.
# Leave empty locally to disable maintenance-mode checks.
EDGE_CONFIG=

# --- Sentry (optional locally) ---
# Build-time only: uploads source maps during `next build`. Sentry -> Settings -> Auth Tokens.
# The Sentry wizard may store this in .env.sentry-build-plugin instead (also git-ignored).
SENTRY_AUTH_TOKEN=

# --- E2E tests (Playwright) ---
# Test account. tests/auth.setup.ts signs it up automatically if it doesn't exist.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Any long random string (e.g. `openssl rand -hex 32`). Protects app/api/test/cleanup;
# the Next server and the Playwright run both read it from this file.
TEST_API_KEY=
# Optional: port for the dev server Playwright starts (default 3000).
# PORT=3000

# =============================================================================
# Convex deployment environment
# These are read by code in convex/, which runs on Convex's servers and does NOT
# see .env.local. Set them with `npx convex env set NAME value` or in the
# Convex dashboard -> Settings -> Environment Variables.
# =============================================================================

# Origin of the Next.js app, used as Better Auth's baseURL in convex/auth.ts (http://localhost:3000 locally).
SITE_URL=
# Better Auth signing secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# OAuth providers. Callback URL for each: <SITE_URL>/api/auth/callback/<github|google|linkedin>
# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn Developer Portal -> My Apps -> Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# AI title generator (convex/groq.ts). https://console.groq.com/keys
GROQ_API_KEY=

# Set automatically, do not add: CONVEX_SITE_URL (Convex built-in), NEXT_RUNTIME, CI,
# VERCEL_ENV (set by Vercel; 'production' turns off the /api/test/cleanup route).
